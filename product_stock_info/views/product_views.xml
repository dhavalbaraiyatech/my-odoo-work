<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_product_tree_inherit_product_stock_info" model="ir.ui.view">
        <field name="name">product.product.list.product.stock.info</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.view_stock_product_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='virtual_available']" position="after">
                <widget name="stock_info_widget"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_product_template_tree_inherit_product_stock_info" model="ir.ui.view">
        <field name="name">product.template.list.product.stock.info</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_stock_product_template_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='virtual_available']" position="after">
                <widget name="stock_info_widget"/>
            </xpath>
        </field>
    </record>

</odoo>
