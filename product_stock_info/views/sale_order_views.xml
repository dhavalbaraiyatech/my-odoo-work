<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_product_stock_info" model="ir.ui.view">
        <field name="name">sale.order.form.product.stock.info</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Sale Order Lines list: next to the visible product column -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_template_id']" position="after">
                <widget name="stock_info_widget"
                        options="{'product_field': 'product_id', 'warehouse_field': 'warehouse_id'}"/>
            </xpath>
            <!-- Sale Order Lines form (mobile / kanban edit): next to the product field -->
            <xpath expr="//field[@name='order_line']//form//field[@name='product_id']" position="after">
                <widget name="stock_info_widget"
                        options="{'product_field': 'product_id', 'warehouse_field': 'warehouse_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
